{
  "version": "2.1.0",
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "SwiftLint",
          "informationUri": "https://github.com/realm/SwiftLint",
          "rules": [
            {"id": "print_of_secret", "shortDescription": {"text": "Print of a secret value"}},
            {"id": "userdefaults_secret_key", "shortDescription": {"text": "Secret stored in UserDefaults"}},
            {"id": "force_cast", "shortDescription": {"text": "Force Cast"}},
            {"id": "identifier_name", "shortDescription": {"text": "Identifier Name"}}
          ]
        }
      },
      "results": [
        {
          "ruleId": "print_of_secret",
          "level": "error",
          "message": {"text": "A secret-like value is written to the log. Remove it or log a redacted form."},
          "locations": [{"physicalLocation": {"artifactLocation": {"uri": "file:///work/app/Sources/Login.swift"}, "region": {"startLine": 12, "startColumn": 9}}}]
        },
        {
          "ruleId": "userdefaults_secret_key",
          "level": "error",
          "message": {"text": "UserDefaults is not encrypted storage. Keep secrets in the Keychain."},
          "locations": [{"physicalLocation": {"artifactLocation": {"uri": "file:///work/app/Sources/Store.swift"}, "region": {"startLine": 5, "startColumn": 5}}}]
        },
        {
          "ruleId": "force_cast",
          "level": "error",
          "message": {"text": "Force casts should be avoided"},
          "locations": [{"physicalLocation": {"artifactLocation": {"uri": "file:///work/app/Sources/Store.swift"}, "region": {"startLine": 20, "startColumn": 15}}}]
        },
        {
          "ruleId": "identifier_name",
          "level": "warning",
          "message": {"text": "Variable name 'x' should be between 3 and 40 characters long"},
          "locations": [{"physicalLocation": {"artifactLocation": {"uri": "file:///work/app/Sources/Login.swift"}, "region": {"startLine": 3, "startColumn": 9}}}]
        }
      ]
    }
  ]
}
