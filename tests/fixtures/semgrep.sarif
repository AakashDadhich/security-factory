{
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "Semgrep OSS",
          "semanticVersion": "1.0.0",
          "rules": [
            {
              "id": "python.lang.security.audit.formatted-sql-query.formatted-sql-query",
              "name": "python.lang.security.audit.formatted-sql-query.formatted-sql-query",
              "shortDescription": { "text": "Semgrep Finding: python.lang.security.audit.formatted-sql-query.formatted-sql-query" },
              "fullDescription": { "text": "Detected possible formatted SQL query." },
              "defaultConfiguration": { "level": "error" },
              "help": { "text": "Use parameterized queries instead of string formatting." },
              "properties": {
                "precision": "very-high",
                "tags": [
                  "CWE-89: Improper Neutralization of Special Elements used in an SQL Command ('SQL Injection')",
                  "OWASP-A03:2021 - Injection",
                  "security"
                ]
              }
            },
            {
              "id": "python.flask.security.audit.debug-enabled.debug-enabled",
              "name": "python.flask.security.audit.debug-enabled.debug-enabled",
              "shortDescription": { "text": "Semgrep Finding: python.flask.security.audit.debug-enabled.debug-enabled" },
              "fullDescription": { "text": "Detected Flask app with debug=True." },
              "defaultConfiguration": { "level": "warning" },
              "help": { "text": "Remove debug=True before deploying." },
              "properties": {
                "tags": ["CWE-489: Active Debug Code", "security"]
              }
            },
            {
              "id": "generic.style.todo",
              "name": "generic.style.todo",
              "shortDescription": { "text": "Semgrep Finding: generic.style.todo" },
              "defaultConfiguration": { "level": "note" },
              "properties": { "tags": [] }
            }
          ]
        }
      },
      "results": [
        {
          "ruleId": "python.lang.security.audit.formatted-sql-query.formatted-sql-query",
          "level": "error",
          "message": { "text": "Detected possible formatted SQL query. Use parameterized queries instead." },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": { "uri": "app/db.py", "uriBaseId": "%SRCROOT%" },
                "region": { "startLine": 12, "startColumn": 5, "endLine": 12, "endColumn": 60 }
              }
            }
          ]
        },
        {
          "ruleId": "python.lang.security.audit.formatted-sql-query.formatted-sql-query",
          "level": "error",
          "message": { "text": "Detected possible formatted SQL query. Use parameterized queries instead." },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": { "uri": "app/db.py", "uriBaseId": "%SRCROOT%" },
                "region": { "startLine": 12, "startColumn": 70, "endLine": 12, "endColumn": 90 }
              }
            }
          ]
        },
        {
          "ruleId": "python.flask.security.audit.debug-enabled.debug-enabled",
          "level": "warning",
          "message": { "text": "Detected Flask app with debug=True." },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": { "uri": "./app/main.py" },
                "region": { "startLine": 40, "endLine": 40 }
              }
            }
          ]
        },
        {
          "ruleId": "generic.style.todo",
          "level": "note",
          "message": { "text": "TODO left in code." },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": { "uri": "app/main.py" },
                "region": { "startLine": 3 }
              }
            }
          ]
        }
      ]
    }
  ]
}
