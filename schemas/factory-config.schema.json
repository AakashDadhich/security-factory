{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/AakashDadhich/security-factory/schemas/factory-config.schema.json",
  "title": "Project factory config",
  "description": "The .factory.yml file in each project repo.",
  "type": "object",
  "additionalProperties": false,
  "required": ["platform"],
  "properties": {
    "platform": {
      "enum": ["web", "macos", "ios"]
    },
    "asvs_level": {
      "description": "1, 2 or 3. null or absent means the default rule (D2): level 2.",
      "type": ["integer", "null"],
      "minimum": 1,
      "maximum": 3
    },
    "web": {
      "type": "object",
      "additionalProperties": false,
      "required": ["port", "health_path", "dockerfile"],
      "properties": {
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "health_path": {
          "type": "string",
          "pattern": "^/[^\\s]*$"
        },
        "openapi": {
          "$ref": "#/$defs/relative_path"
        },
        "dockerfile": {
          "$ref": "#/$defs/relative_path"
        },
        "auth": {
          "description": "Optional test login for authenticated ZAP scans. The credentials come from .env.example, never from real accounts.",
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "login_url", "username_field", "password_field", "username_env", "password_env"],
          "anyOf": [
            {"required": ["logged_in_regex"]},
            {"required": ["logged_out_regex"]}
          ],
          "properties": {
            "type": {"enum": ["form", "json"]},
            "login_url": {
              "description": "Path on the app, for example /login.",
              "type": "string",
              "pattern": "^/(?!/)[^\\s]*$"
            },
            "username_field": {"$ref": "#/$defs/field_name"},
            "password_field": {"$ref": "#/$defs/field_name"},
            "username_env": {"$ref": "#/$defs/env_name"},
            "password_env": {"$ref": "#/$defs/env_name"},
            "logged_in_regex": {"type": "string", "minLength": 1, "maxLength": 200},
            "logged_out_regex": {"type": "string", "minLength": 1, "maxLength": 200}
          }
        }
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "fail_on_extra": {
          "description": "Severities that also fail the gate, on top of the factory policy. Can only add levels.",
          "type": "array",
          "uniqueItems": true,
          "items": {"enum": ["medium", "low", "info"]}
        }
      }
    },
    "suppressions": {
      "description": "Time-limited waivers. Entries are checked by the gate, which ignores and reports bad ones.",
      "type": "array",
      "items": {"type": "object"}
    },
    "apple": {
      "type": "object",
      "additionalProperties": false,
      "required": ["project_spec", "scheme"],
      "properties": {
        "project_spec": {
          "$ref": "#/$defs/relative_path"
        },
        "scheme": {
          "type": "string",
          "pattern": "^[A-Za-z0-9 ._-]+$"
        }
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"platform": {"const": "web"}}},
      "then": {"required": ["web"]}
    },
    {
      "if": {"properties": {"platform": {"enum": ["macos", "ios"]}}},
      "then": {"required": ["apple"]}
    }
  ],
  "$defs": {
    "field_name": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.\\[\\]-]{1,64}$"
    },
    "env_name": {
      "type": "string",
      "pattern": "^[A-Z_][A-Z0-9_]{0,63}$"
    },
    "relative_path": {
      "description": "A path inside the repo: not absolute, no '..' segments, no whitespace other than spaces.",
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!(.*/)?\\.\\.(/|$))[^\\t\\n\\r]+$"
    }
  }
}
